PORT=8090
APP_ENV=development
DATABASE_URL=postgres://fieldsync:fieldsync@localhost:5433/fieldsync?sslmode=disable
# Dev-only secret. Generate a real random value per environment in production
# (e.g. `openssl rand -hex 32`) and never commit it.
JWT_SECRET=dev-only-insecure-secret-change-me
# Local-disk storage for uploaded files (daily report PDFs). Swap for S3 or
# similar before production — see AGENTS.md production-readiness notes.
STORAGE_DIR=./data/uploads
